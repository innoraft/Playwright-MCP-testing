# --------------------
# Dependencies
# --------------------
node_modules/

# --------------------
# Logs
# --------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------
# Environment variables
# --------------------
.env
.env.*

# --------------------
# Tests (runtime-generated YAML)
# --------------------
/tests

# --------------------
# Test reports (runtime-generated HTML)
# --------------------
test-reports/

# --------------------
# files (runtime only)
# Keep directory structure via .gitkeep
# --------------------
files/uploads/*
!files/uploads/.gitkeep
files/baselines/*
!files/baselines/.gitkeep
files/diffs/*
!files/diffs/.gitkeep
files/screenshots/*
!files/screenshots/.gitkeep

# --------------------
# Config (sensitive / per-deployment)
# --------------------
config/llm.config.json
config/users.json
config/ownership.json

# --------------------
# Build output
# --------------------
client/dist/

# --------------------
# Cache / temp
# --------------------
.test-cache/
tmp/
temp/

# --------------------
# OS / Editor noise
# --------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
